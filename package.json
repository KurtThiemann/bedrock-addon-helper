{
    "name": "bedrock-addon-helper",
    "version": "2.0.0-dev",
    "description": "A CLI tool for building and testing Minecraft Bedrock Edition add-ons",
    "license": "MIT",
    "author": "Kurt Thiemann <kurt@aternos.org>",
    "type": "module",
    "bin": {
        "bah": "dist/bin.js"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "lint": "biome check .",
        "format": "biome check --write .",
        "test": "node --test \"src/**/*.test.ts\"",
        "dev": "node src/bin.ts",
        "prepack": "npm run build"
    },
    "dependencies": {
        "commander": "^15.1.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.8",
        "@types/node": "^24.0.0",
        "typescript": "^7.0.2"
    }
}
