{
    "name": "@kurtthiemann/bah",
    "version": "0.0.0-dev",
    "description": "A CLI tool for building and testing Minecraft Bedrock Edition add-ons",
    "license": "MIT",
    "author": "Kurt Thiemann <kurt@aternos.org>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/KurtThiemann/bedrock-addon-helper.git"
    },
    "homepage": "https://github.com/KurtThiemann/bedrock-addon-helper#readme",
    "bugs": {
        "url": "https://github.com/KurtThiemann/bedrock-addon-helper/issues"
    },
    "keywords": [
        "minecraft",
        "bedrock",
        "addon",
        "behavior-pack",
        "resource-pack",
        "script-api",
        "cli"
    ],
    "type": "module",
    "bin": {
        "bah": "dist/bin.js"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "lint": "biome check .",
        "format": "biome check --write .",
        "test": "node --test \"src/**/*.test.ts\"",
        "dev": "node src/bin.ts",
        "prepack": "npm run build"
    },
    "dependencies": {
        "chokidar": "^6.0.0",
        "commander": "^15.1.0",
        "esbuild": "^0.28.2",
        "fflate": "^0.8.3",
        "prismarine-nbt": "^2.8.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.8",
        "@types/node": "^24.0.0",
        "typescript": "^7.0.2"
    }
}
